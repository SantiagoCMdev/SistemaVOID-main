# Application
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production
STREAM_TOKEN_SECRET=stream_signing_secret_key_minimum_32_chars
STREAM_TOKEN_TTL_SECONDS=120

# Database (PostgreSQL with ACID transactions)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vod_platform?schema=public&connection_limit=20"

# Redis (Caching, Idempotency Locks, Stream Token Blacklists, Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Search Engine (Meilisearch)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey123

# Payment Gateway (Stripe/Custom)
PAYMENT_GATEWAY_SECRET_KEY=sk_test_mock_secret_key
PAYMENT_WEBHOOK_SECRET=whsec_mock_webhook_secret

# CDN / Video Stream Storage
CDN_BASE_URL=https://stream.vodplatform.com/hls
