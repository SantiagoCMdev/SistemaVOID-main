datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  fullName      String         @map("full_name") @db.VarChar(120)
  role          UserRole       @default(USER)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions    Subscription[]
  playbackProgress PlaybackProgress[]
  favorites        Favorite[]
  comments         Comment[]
  activeStreams    ActiveSessionStream[]
  invoices         Invoice[]
  settings         UserSettings?

  @@map("users")
}

model Plan {
  id                   String          @id @default(uuid()) @db.Uuid
  name                 String          @db.VarChar(100)
  slug                 String          @unique @db.VarChar(50)
  priceCents           Int             @map("price_cents") // En centavos para evitar redondeos flotantes
  currency             String          @default("USD") @db.VarChar(3)
  interval             BillingInterval @default(MONTHLY)
  maxConcurrentStreams Int             @default(1) @map("max_concurrent_streams")
  maxResolution        String          @default("1080p") @map("max_resolution") @db.VarChar(10)
  isActive             Boolean         @default(true) @map("is_active")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptions        Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  planId               String             @map("plan_id") @db.Uuid
  status               SubscriptionStatus @default(INCOMPLETE)
  
  currentPeriodStart   DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime           @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?          @map("canceled_at") @db.Timestamptz(6)
  
  // Para downgrades diferidos al final del ciclo
  pendingDowngradePlanId String?          @map("pending_downgrade_plan_id") @db.Uuid
  
  paymentGatewaySubId  String?            @unique @map("payment_gateway_sub_id") @db.VarChar(255)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])
  invoices             Invoice[]

  @@index([userId, status])
  @@map("subscriptions")
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  subscriptionId     String?       @map("subscription_id") @db.Uuid
  idempotencyKey     String        @unique @map("idempotency_key") @db.VarChar(128)
  amountCents        Int           @map("amount_cents")
  currency           String        @default("USD") @db.VarChar(3)
  status             PaymentStatus @default(PENDING)
  paymentGatewayRef  String?       @map("payment_gateway_ref") @db.VarChar(255)
  billingReason      String        @map("billing_reason") @db.VarChar(50) // UPGRADE_PRORATION, NEW_SUBSCRIPTION, RENEWAL
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user               User          @relation(fields: [userId], references: [id])
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("invoices")
}

model Video {
  id                   String             @id @default(uuid()) @db.Uuid
  title                String             @db.VarChar(255)
  slug                 String             @unique @db.VarChar(255)
  description          String             @db.Text
  durationSeconds      Int                @map("duration_seconds")
  releaseYear          Int                @map("release_year")
  ageRating            String             @default("PG-13") @map("age_rating") @db.VarChar(10)
  thumbnailUrl         String             @map("thumbnail_url") @db.VarChar(500)
  posterUrl            String             @map("poster_url") @db.VarChar(500)
  hlsMasterPlaylistUrl String             @map("hls_master_playlist_url") @db.VarChar(500)
  isPublished          Boolean            @default(false) @map("is_published")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  metadata             VideoMetadata?
  playbackProgress     PlaybackProgress[]
  favorites            Favorite[]
  comments             Comment[]
  activeStreams        ActiveSessionStream[]

  @@index([isPublished, releaseYear])
  @@map("videos")
}

model VideoMetadata {
  id                 String   @id @default(uuid()) @db.Uuid
  videoId            String   @unique @map("video_id") @db.Uuid
  genres             String[] @db.VarChar(50)
  actors             String[] @db.VarChar(100)
  directors          String[] @db.VarChar(100)
  originalLanguage   String   @default("es") @map("original_language") @db.VarChar(10)
  availableLanguages String[] @default(["es", "en"]) @map("available_languages") @db.VarChar(10)
  subtitles          String[] @default(["es", "en"]) @db.VarChar(10)

  video              Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_metadata")
}

model PlaybackProgress {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  videoId             String   @map("video_id") @db.Uuid
  lastPositionSeconds Int      @default(0) @map("last_position_seconds")
  totalDurationSeconds Int     @map("total_duration_seconds")
  completed           Boolean  @default(false)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video               Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId], name: "user_video_progress_unique")
  @@map("playback_progress")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  videoId   String   @map("video_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId], name: "user_video_favorite_unique")
  @@map("favorites")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  videoId   String   @map("video_id") @db.Uuid
  content   String   @db.VarChar(1000)
  isFlagged Boolean  @default(false) @map("is_flagged")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt(sort: Desc)])
  @@map("comments")
}

model ActiveSessionStream {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  sessionId      String   @map("session_id") @db.VarChar(100)
  videoId        String   @map("video_id") @db.Uuid
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  deviceInfo     String?  @map("device_info") @db.VarChar(255)
  lastHeartbeatAt DateTime @default(now()) @map("last_heartbeat_at") @db.Timestamptz(6)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([userId, lastHeartbeatAt])
  @@map("active_session_streams")
}

model UserSettings {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  language        String   @default("es") @db.VarChar(10)
  theme           String   @default("dark") @db.VarChar(20)
  notifications   Boolean  @default(true)
  autoplay        Boolean  @default(true)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
